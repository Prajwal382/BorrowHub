# Copy to .env for local development. The database values match docker-compose.yml.
DATABASE_URL="postgresql://borrowhub:borrowhub@localhost:5432/borrowhub"
TEST_DATABASE_URL="postgresql://borrowhub:borrowhub@localhost:5433/borrowhub_test"

# Encrypts session cookies and must be at least 32 characters. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# All "today" and overdue logic uses this IANA time zone.
ORG_TIME_ZONE="America/Chicago"
